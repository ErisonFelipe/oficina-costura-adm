generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

}

// ===== ORÇAMENTOS / CONTATOS =====
model Quote {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  service   String?
  message   String
  status    QuoteStatus @default(PENDING)
  notes     String?  // anotações internas
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum QuoteStatus {
  PENDING     // Aguardando resposta
  IN_PROGRESS // Em andamento
  COMPLETED   // Concluído
  CANCELLED   // Cancelado
}

// ===== GALERIA =====
model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   // "vestido", "terno", "bainha"...
  filename    String   // nome do arquivo salvo
  originalName String  // nome original enviado
  mimeType    String
  size        Int      // em bytes
  width       Int?
  height      Int?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([active])
}

// ===== SERVIÇOS (dinâmico, opcional) =====
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String   // nome do ícone
  tag         String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== CONFIGURAÇÕES DO SITE =====
model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ===== ROMANEIOS DE CORTE =====
model Romaneio {
  id                     String   @id @default(cuid())
  numero                 String   @unique
  cliente                String
  data                   DateTime
  produto                String
  referencia             String?
  tipoTecido             String?
  quantidadeRolos        Int?
  quantidadeFolhas       Int?
  quantidadeEncaixados   Int?
  quantidadePecas        Int
  quantidadeVolumes      Int?
  cortadorResponsavel    String?
  conferidoPor           String?
  grade                  Json
  cobranca               Json
  observacoes            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([cliente])
  @@index([createdAt])
}

// ===== USUÁRIOS ADMINISTRATIVOS =====
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(ADMIN)
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}
